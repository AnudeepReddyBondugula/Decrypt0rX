# Copy to .env at the repository root, then append generated secrets:
#   cp deploy/.env.example .env && ./deploy/generate-secrets.sh >> .env

# --- Required secrets (generate, never commit) --------------------------------
# DECRYPT0RX_MASTER_KEY=      # 32 bytes, base64. Wraps CA private keys at rest.
# DECRYPT0RX_JWT_SECRET=      # Signs GUI session tokens.
# POSTGRES_PASSWORD=
# MINIO_ROOT_PASSWORD=

# --- Ports --------------------------------------------------------------------
PROXY_PORT=8080
API_PORT=8000
WEB_PORT=3000
PROXY_METRICS_PORT=9090
MINIO_CONSOLE_PORT=9001

# --- Web ----------------------------------------------------------------------
# The API URL as reached from the browser. Change both of these together when
# serving Decrypt0rX from anything other than localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000
DECRYPT0RX_CORS_ORIGINS=http://localhost:3000

# --- First-boot admin ---------------------------------------------------------
DECRYPT0RX_BOOTSTRAP_ADMIN_EMAIL=admin@decrypt0rx.io
# Leave blank to have a strong password generated and printed once in the logs.
DECRYPT0RX_BOOTSTRAP_ADMIN_PASSWORD=

# --- Proxy behaviour ----------------------------------------------------------
DECRYPT0RX_NODE_ID=proxy-1
# Action when no policy rule matches: intercept | bypass | block
DECRYPT0RX_DEFAULT_ACTION=intercept
# Leave verification on. Turning it off means the proxy itself stops detecting
# a man-in-the-middle between it and origin servers.
DECRYPT0RX_VERIFY_UPSTREAM=true
DECRYPT0RX_MAX_CONNECTIONS=2000
DECRYPT0RX_RATE_LIMIT_ENABLED=false
DECRYPT0RX_RATE_LIMIT_PER_MINUTE=1200

# --- Retention ----------------------------------------------------------------
DECRYPT0RX_FLOW_RETENTION_DAYS=14

# --- Logging ------------------------------------------------------------------
DECRYPT0RX_LOG_LEVEL=INFO
# console | json
DECRYPT0RX_LOG_FORMAT=console
